{
  "version": "ladder-v1",
  "timezone": "Asia/Shanghai",
  "intervals_days": [
    1,
    3,
    7,
    14,
    30
  ],
  "new_limit": 2,
  "review_limit": 5,
  "low_priority": "reference_only",
  "trigger": "on_conversation",
  "background_enabled": false,
  "question_version": "questions-v1",
  "backlog_path": "knowledge/questions/backlog.json",
  "resume_before_new": true,
  "carryover_counts_toward_limits": true,
  "review_quantity_policy": "user_controlled",
  "review_limit_is_initial_batch": true,
  "daily_review_cap": null,
  "answer_publication": {
    "policy": "standing_authorization",
    "effective_on": "2026-10-11",
    "scope": "knowledge_diagnostic_and_review_answers",
    "include": [
      "verbatim_answers",
      "partial_answers",
      "hint_or_lookup_context",
      "evaluation"
    ],
    "ask_each_time": false,
    "user_explicit_exclusions_override": true
  }
}
