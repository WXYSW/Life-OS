{
  "version": "ladder-v2",
  "timezone": "Asia/Shanghai",
  "intervals_days": [
    1,
    3,
    7,
    14,
    30,
    60,
    90
  ],
  "new_limit": 2,
  "review_limit": 5,
  "low_priority": "reference_only",
  "trigger": "on_conversation",
  "background_enabled": false,
  "review_quantity_policy": "user_controlled",
  "review_limit_is_initial_batch": true,
  "daily_review_cap": null,
  "answer_publication": {
    "policy": "standing_authorization",
    "effective_on": "2026-10-11",
    "scope": "knowledge_diagnostic_and_review_answers",
    "include": [
      "compact_evidence",
      "weaknesses",
      "hint_or_lookup_context",
      "evaluation_summary"
    ],
    "ask_each_time": false,
    "user_explicit_exclusions_override": true
  },
  "planner_version": "review-v3",
  "planner_entrypoint": "scripts/learning.py",
  "legacy_selector": "scripts/review.py select (compatibility only)",
  "schedule_policy": {
    "consolidation_intervals_days": [
      1,
      3,
      7
    ],
    "long_interval_required_passes": 2,
    "max_interval_days": 90,
    "parameter_basis": "provisional_engineering_defaults"
  },
  "knowledge_catalog_version": "taxonomy-v2",
  "knowledge_catalog_path": "knowledge/catalog",
  "evidence_storage": "compact_scope_evidence",
  "persist_questions": false,
  "lifecycle_version": "lifecycle-v1",
  "default_mode": "review",
  "diagnosis_trigger": "explicit_user_request",
  "queue_policy": "derived_from_canonical_knowledge",
  "knowledge_entity_prefix": "KP-",
  "round_profiles": {
    "light": {
      "max_scopes": 3
    },
    "standard": {
      "max_scopes": 5
    },
    "deep": {
      "max_scopes": 8
    }
  },
  "memory_model": "ladder-v2-cold-start",
  "risk_model": "ordinal_observed_evidence",
  "adaptive_intervals_enabled": false
}
